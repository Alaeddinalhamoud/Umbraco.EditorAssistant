@model Umbraco.EditorAssistant.Models.EditorAssistantViewModel

<a class="editor-assistant"
   href="@Model.EditUrl"
   target="_blank"
   aria-label="Edit @Model.ContentName in Umbraco (opens in a new tab)"
   title="Edit @Model.ContentName in Umbraco (opens in a new tab)"
   rel="nofollow noopener noreferrer">
    <svg class="editor-assistant__icon"
         viewBox="0 0 24 24"
         width="20"
         height="20"
         aria-hidden="true"
         focusable="false">
        <path fill="currentColor"
              d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25Zm17.71-10.04a1.003 1.003 0 0 0 0-1.42l-2.5-2.5a1.003 1.003 0 0 0-1.42 0l-1.96 1.96 3.75 3.75 2.13-1.79Z" />
    </svg>
    <span class="editor-assistant__label">Editor Assistant</span>
</a>
