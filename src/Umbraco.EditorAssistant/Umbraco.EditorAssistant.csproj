<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
	<StaticWebAssetBasePath>App_Plugins/EditorAssistant.Umbraco</StaticWebAssetBasePath>
	<AddRazorSupportForMvc>true</AddRazorSupportForMvc>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>EditorAssistant.Umbraco</PackageId>
    <Product>Umbraco.EditorAssistant</Product>
    <Title>Umbraco.EditorAssistant</Title>
	<Version>1.1.1</Version>
	<Authors>Alaeddin Alhamoud</Authors>
	<Copyright>Copyright © 2026 Alaeddin Alhamoud</Copyright>
	<Description>Adds an authenticated front-end Editor Assistant link for Umbraco 17 and 18 content editors.</Description>
	<PackageReleaseNotes>Add the package stylesheet inside head and call the EditorAssistant View Component inside body in your shared Razor layout. See the package README for both snippets and upgrade instructions. Requires Umbraco 17.8.2 or later in the 17.x series, or Umbraco 18.</PackageReleaseNotes>
	<PackageTags>umbraco;umbraco17;umbraco18;backoffice;editor</PackageTags>
	<PackageLicenseExpression>MIT</PackageLicenseExpression>
	<PackageProjectUrl>https://github.com/Alaeddinalhamoud/Umbraco.EditorAssistant</PackageProjectUrl>
	<RepositoryUrl>https://github.com/Alaeddinalhamoud/Umbraco.EditorAssistant</RepositoryUrl>
	<RepositoryType>git</RepositoryType>
	<PackageReadmeFile>README.md</PackageReadmeFile>
	<PackageIcon>Umbraco.EditorAssistant/icon.png</PackageIcon>
	<IsPackable>true</IsPackable>
  </PropertyGroup>


  <!-- Central package management - no versions -->
  <ItemGroup>
    <PackageReference Include="Umbraco.Cms.Web.Common" />
  </ItemGroup>

	<ItemGroup>
		<None Include="..\..\README.md" Pack="true" PackagePath="\" Link="README.md" />
		<None Include="icon.png" Pack="true" PackagePath="Umbraco.EditorAssistant\" />
	</ItemGroup>
	<ItemGroup>
    <Folder Include="wwwroot\" />
  </ItemGroup>

</Project>
