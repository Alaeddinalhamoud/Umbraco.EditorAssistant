<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Compile against the oldest supported API; let the host select 17.x or 18.x. -->
    <PackageVersion Include="Umbraco.Cms.Web.Common" Version="[17.8.2,19.0.0)" />
  </ItemGroup>
</Project>
